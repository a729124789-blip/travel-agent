# ===== 应用 =====
APP_NAME=智能旅行助手
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== LLM =====
# 腾讯云 TokenHub / 其他 OpenAI 兼容接口的 API Key
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 按任务类型分别配置模型名（改这里即可切换模型，无需改代码）
LLM_MODEL_DEFAULT=deepseek-v4-flash
LLM_MODEL_INTENT=deepseek-v4-flash
LLM_MODEL_PLANNING=glm-5.3-flash
LLM_MODEL_RAG=deepseek-v4-flash

# ===== 高德地图 =====
# 高德开放平台 Web 服务 API Key（用于 POI 搜索、天气、地理编码等）
AMAP_KEY=your_amap_key_here

# ===== Unsplash（图片素材，备用） =====
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ===== MCP 服务 URL（魔搭 ModelScope 托管） =====
# 在 ModelScope 申请对应 MCP 后获取的专属 URL（含 UUID）
# 12306 火车票 MCP
RAIL_MCP_URL=https://mcp.api-inference.modelscope.net/your_uuid/mcp
# RollingGo 酒店搜索推荐 MCP
HOTEL_MCP_URL=https://mcp.api-inference.modelscope.net/your_uuid/mcp

# ===== 向量库 =====
# milvus(Docker) / milvus_lite / chroma / faiss
VECTOR_STORE_TYPE=milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=business_travel_knowledge
